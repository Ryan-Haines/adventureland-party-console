// Discovery: the one place that reads runtime/addons/. A browser bundle cannot read a folder at
// run time, so every build tool calls writeInstalled first, and the bundles import the three
// modules it writes under .build/addons/. Git ignores them and nobody edits them.
import { existsSync, mkdirSync, readdirSync, readFileSync, renameSync, writeFileSync } from 'node:fs';
import path from 'node:path';
import { fileURLToPath } from 'node:url';

// This checkout's root, and the root a command works on: `--root <dir>` names another checkout, as
// the add-on tests do.
export const ROOT = fileURLToPath(new URL('../../../', import.meta.url));
export const rootOf = (args: readonly string[]) => { const at = args.indexOf('--root'); return at >= 0 ? path.resolve(args[at + 1]!) : ROOT; };

// An add-on's name is its folder's: lower case letters, digits and dashes, such as boss-zones.
export const ADDON_NAME = /^[a-z][a-z0-9-]*$/;
const HEADER = '// Generated by runtime/hooks/build/installed.mts from runtime/addons/. Do not edit.\n';
// The two files beside the folders: the add-on guide and the generated hook list.
export const GUIDE_FILES: readonly string[] = ['README.md', 'HOOKS.md'];

// The add-on-neutral fixture (fixtures/answer-all/index.ts), which only `npm run test:addon-neutral`
// installs.
export const FIXTURE = { folder: 'answer-all', dir: 'runtime/hooks/fixtures/answer-all', dashboard: false, rows: false } as const;
// `dir` is the folder's path from the root; an add-on's is runtime/addons/<folder>.
export interface InstalledFolder { folder: string; dashboard: boolean; rows: boolean; dir?: string }

// The add-on folders in code-point order of their names, so a conflict refuses the same add-on
// on every machine. A half-copied add-on stops the build with its folder named. Under
// PARTY_ADDON_FIXTURE=1 the fixture follows them in a checkout that holds it; a test's scratch
// checkout holds only add-on folders.
export function installedFolders(root: string): InstalledFolder[] {
  const dir = path.join(root, 'runtime/addons');
  const fixture = process.env.PARTY_ADDON_FIXTURE === '1' && existsSync(path.join(root, FIXTURE.dir, 'index.ts')) ? [FIXTURE] : [];
  if (!existsSync(dir)) return fixture;
  const out: InstalledFolder[] = [];
  for (const entry of readdirSync(dir, { withFileTypes: true }).sort((a, b) => a.name < b.name ? -1 : a.name > b.name ? 1 : 0)) {
    if (!entry.isDirectory() && GUIDE_FILES.includes(entry.name)) continue;
    if (!entry.isDirectory()) throw Error(`runtime/addons/${entry.name} is a file; runtime/addons/ holds only add-on folders, README.md and HOOKS.md`);
    const at = path.join(dir, entry.name);
    if (!ADDON_NAME.test(entry.name)) throw Error(`runtime/addons/${entry.name} is not an add-on name: lower case letters, digits and dashes`);
    if (!existsSync(path.join(at, 'index.ts'))) throw Error(`runtime/addons/${entry.name} has no index.ts, so it is not an add-on`);
    if (!existsSync(path.join(at, 'README.md'))) throw Error(`runtime/addons/${entry.name} has no README.md, which holds the add-on's questions`);
    out.push({ folder: entry.name, dashboard: existsSync(path.join(at, 'dashboard.tsx')), rows: existsSync(path.join(at, 'tests/rows.ts')) });
  }
  return [...out, ...fixture];
}

// The three modules' text for the folders found: the registrations, the dashboard sections and
// the E2E rows. Only the E2E specs import the rows, so no bundle holds a test. The folder's
// package.json makes the three ES modules.
export function installedModules(folders: readonly InstalledFolder[]): Record<'runtime.ts' | 'dashboard.ts' | 'tests.ts' | 'package.json', string> {
  const dirs = new Map(folders.map(f => [f.folder, f.dir ?? `runtime/addons/${f.folder}`]));
  const at = (folder: string, file: string) => JSON.stringify(`../../${dirs.get(folder)}/${file}`);
  const sections = folders.filter(f => f.dashboard), rows = folders.filter(f => f.rows);
  return {
    'runtime.ts': HEADER + "import type { Registration } from '../../runtime/hooks/registry.ts';\n" +
      folders.map((f, i) => `import { registration as r${i} } from ${at(f.folder, 'index.ts')};\n`).join('') +
      'export const installed: readonly { folder: string; registration: Registration }[] = [\n' +
      folders.map((f, i) => `  { folder: ${JSON.stringify(f.folder)}, registration: r${i} },\n`).join('') + '];\n',
    'dashboard.ts': HEADER + "import type { AddonDashboard } from '../../dashboard/features/party/addon-kit.ts';\n" +
      sections.map((f, i) => `import { dashboard as d${i} } from ${at(f.folder, 'dashboard.tsx')};\n`).join('') +
      'export const dashboards: Readonly<Record<string, AddonDashboard>> = {\n' +
      sections.map((f, i) => `  ${JSON.stringify(f.folder)}: d${i},\n`).join('') + '};\n',
    // Each add-on's tests/rows.ts exports `rows`, its rows keyed by the shared table they join.
    'tests.ts': HEADER + rows.map((f, i) => `import { rows as t${i} } from ${at(f.folder, 'tests/rows.ts')};\n`).join('') +
      `const all: readonly Readonly<Record<string, readonly unknown[]>>[] = [${rows.map((_, i) => `t${i}`).join(', ')}];\n` +
      '// The installed add-ons\' rows of one shared table, in load order.\n' +
      'export const rows = <Row>(table: string): Row[] => all.flatMap(module => (module[table] ?? []) as Row[]);\n',
    // .build/ sits under the root package.json, which sets no module type, so without this file
    // Playwright loads runtime.ts as CommonJS and its import of an add-on fails. JSON holds no
    // comment, so the file carries no HEADER.
    'package.json': '{ "private": true, "type": "module" }\n',
  };
}

// Writes a module only when its text changes, so an unchanged install rebuilds nothing.
export function writeInstalled(root: string): string[] {
  const folders = installedFolders(root), out = path.join(root, '.build/addons');
  mkdirSync(out, { recursive: true });
  for (const [name, text] of Object.entries(installedModules(folders))) {
    const file = path.join(out, name);
    if (existsSync(file) && readFileSync(file, 'utf8') === text) continue;
    writeFileSync(file + '.tmp', text);
    renameSync(file + '.tmp', file);
  }
  return folders.map(f => f.folder);
}

if (process.argv[1] && path.resolve(process.argv[1]) === fileURLToPath(import.meta.url)) {
  try { writeInstalled(ROOT); }
  catch (error) { console.error((error as Error).message + '.'); process.exitCode = 1; }
}
