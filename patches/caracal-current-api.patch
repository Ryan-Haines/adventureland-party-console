@@ -2,6 +2,38 @@ const { COORDINATOR_MODULE_PATH } = require("./src/CONSTANTS");
 const ConfigUtil = require("./src/ConfigUtil");
 const StreamMultiplexer = require("./src/StreamMultiplexer");
 const fs = require("fs");
+const path = require("path");
+
+// One supervisor owns the coordinator and its append/compaction store. Without
+// this guard, two launchers can periodically replace the same file with
+// different in-memory snapshots.
+const supervisorLockPath = path.resolve(__dirname, ".caracal-supervisor.lock");
+let supervisorLock;
+try {
+  supervisorLock = fs.openSync(supervisorLockPath, "wx");
+  fs.writeFileSync(supervisorLock, String(process.pid));
+} catch (error) {
+  let stale = false;
+  try {
+    const owner = Number(fs.readFileSync(supervisorLockPath, "utf8"));
+    if (!Number.isSafeInteger(owner)) stale = true;
+    else try { process.kill(owner, 0); } catch (_missingOwner) { stale = true; }
+  } catch (_unreadableLock) { stale = true; }
+  if (stale) {
+    try { fs.unlinkSync(supervisorLockPath); } catch (_unlinkError) {}
+    supervisorLock = fs.openSync(supervisorLockPath, "wx");
+    fs.writeFileSync(supervisorLock, String(process.pid));
+  } else {
+    throw new Error("Another caracAL supervisor already owns " + supervisorLockPath);
+  }
+}
+function releaseSupervisorLock() {
+  if (supervisorLock === undefined) return;
+  try { fs.closeSync(supervisorLock); } catch (_closeError) {}
+  supervisorLock = undefined;
+  try { fs.unlinkSync(supervisorLockPath); } catch (_unlinkError) {}
+}
+process.once("exit", releaseSupervisorLock);
 
 async function get_webpack_started(cfg) {
