-  StreamMultiplexer.setup_log_pipes(log_sinks, COORDINATOR_MODULE_PATH);
+  let coordinator;
+  let coordinatorRestartTimer;
+  let coordinatorStartTimer;
+  let coordinatorWatcher;
+  let restartCoordinator = false;
+  let shuttingDown = false;
+
+  function startCoordinator() {
+    coordinator = StreamMultiplexer.setup_log_pipes(
+      log_sinks,
+      COORDINATOR_MODULE_PATH,
+    );
+    coordinator.once("exit", (code, signal) => {
+      coordinator = null;
+      if (shuttingDown) return process.exit();
+      if (restartCoordinator && !shuttingDown) {
+        restartCoordinator = false;
+        console.log("Coordinator stopped; loading updated code");
+        startCoordinator();
+      } else {
+        console.error(`Coordinator exited unexpectedly (${signal || code}); retrying in 2 seconds`);
+        clearTimeout(coordinatorStartTimer);
+        coordinatorStartTimer = setTimeout(startCoordinator, 2000);
+      }
+    });
+  }
+
+  function sendCoordinator(message) {
+    if (!coordinator || !coordinator.connected) return false;
+    try {
+      coordinator.send(message, (error) => {
+        if (error && !restartCoordinator && !shuttingDown)
+          console.error("Failed to message coordinator", error);
+      });
+      return true;
+    } catch (error) {
+      if (!restartCoordinator && !shuttingDown)
+        console.error("Failed to message coordinator", error);
+      return false;
+    }
+  }
+
+  startCoordinator();
+
+  if (cfg.watch_CODE) {
+    coordinatorWatcher = fs.watch(COORDINATOR_MODULE_PATH, () => {
+      clearTimeout(coordinatorRestartTimer);
+      coordinatorRestartTimer = setTimeout(() => {
+        if (shuttingDown) return;
+        if (!coordinator) {
+          clearTimeout(coordinatorStartTimer);
+          coordinatorStartTimer = setTimeout(startCoordinator, 100);
+          return;
+        }
+        if (restartCoordinator) return;
+        restartCoordinator = true;
+        console.log("Coordinator code changed; restarting caracAL workers");
+        if (!sendCoordinator({ type: "coordinator_shutdown" })) {
+          restartCoordinator = false;
+          coordinator.kill();
+        }
+      }, 400);
+    });
+    console.log(`Watching ${COORDINATOR_MODULE_PATH} for coordinator changes`);
+  }
+
+  ["SIGINT", "SIGTERM", "SIGQUIT"].forEach((signal) =>
+    process.on(signal, () => {
+      shuttingDown = true;
+      clearTimeout(coordinatorRestartTimer);
+      clearTimeout(coordinatorStartTimer);
+      if (coordinatorWatcher) coordinatorWatcher.close();
+      if (!sendCoordinator({ type: "coordinator_shutdown" })) process.exit();
+    }),
+  );
 })();
